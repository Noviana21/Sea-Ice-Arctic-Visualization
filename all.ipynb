      "source": [
        "import pandas as pd\n",
        "import glob\n",
        "import os\n",
        "\n",
        "folder_path = 'north/' 
        "\n",
        "semua_file = glob.glob(os.path.join(folder_path, \"*.csv\"))\n",
        "\n",
        "# --- BAGIAN YANG DIPERBAIKI ---\n",
        "\n",
        "column_names = ['Year', 'Month', 'Data-type', 'Region', 'Extent', 'Area']\n",
        "\n",
        "list_df = []\n",
        "\n",
        "for file in semua_file:\n",
        "    df = pd.read_csv(\n",
        "        file,\n",
        "        header=None,         # Tidak ada header di file\n",
        "        skiprows=1,          # Lewati baris pertama (metadata)\n",
        "        names=column_names,  # Gunakan nama kolom yang kita tentukan\n",
        "        skipinitialspace=True # Menghapus spasi ekstra setelah koma\n",
        "    )\n",
        "    list_df.append(df)\n",
        "    print(f\"Membaca file: {file}\")\n",
        "\n",
        "\n",
        "combined_df = pd.concat(list_df, ignore_index=True)\n",
        "\n",
        "combined_df.to_csv('data_es_arktik_1979-2025_LENGKAP.csv', index=False)\n",
        "\n",
        "print(\"\\nSukses! Semua file telah digabungkan menjadi satu file CSV yang rapi.\")\n",
        "print(\"Total baris data yang digabungkan:\", len(combined_df))\n",
        "print(\"\\nContoh 5 baris pertama dari data gabungan:\")\n",
        "print(combined_df.head())"
      ]
